{
  "name": "font-time",
  "private": true,
  "version": "0.1.0",
  "description": "汉字时光机 — 输入文本 + 拖动时间轴，查看汉字的古今字形演变",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/setup-source.ts && vite",
    "dev:only": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx scripts/setup-source.ts",
    "data:build": "tsx scripts/build-glyphs.ts",
    "data:build:offline": "tsx scripts/build-glyphs.ts --offline"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
